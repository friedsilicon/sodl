// SODL Comprehensive Example
//
// Demonstrates the core constructs: enums, unions, structs, keys,
// objects, keymaps, and instance data.

// Import common types.
// Timestamp is NOT imported — it is a BasicType (see DECISIONS.md, and
// static check 5: importing a name that collides with a BasicType is an
// error, not shadowing).
import { UUID } from "common_types"

// Named literals — D10. A const stands in for its value wherever a literal
// of its type is legal: a range bound, a default, and instance data below.
const MAX_LOGIN_ATTEMPTS: uint8 = 5;
const DEFAULT_THEME: string = "light";

// Enum for user roles
enum UserRole {
    Admin = 1,
    Editor = 2,
    Viewer = 3,
    Guest = 4
}

// Enum for account status
enum AccountStatus {
    Active = 1,
    Suspended = 2,
    Locked = 3,
    Pending = 4
}

// Union type for contact methods
union ContactMethod {
    Email,
    Phone,
    Address
}

// Struct for detailed address.
// D1: every field terminates with ';', in structs as in objects.
struct Address {
    street: string;
    city: string;
    state: string;
    zipCode: string;
    country: string;
}

// Key for User Profile.
// D6: every field named here carries the `key` prop on UserAccount, and
// every `key`-annotated field on UserAccount is reachable from some key
// or keymap. Both directions are checked.
key UserProfile {
    userId: UUID;
    username: string;
    email: string;
}

// Key for Authentication
key AuthKey {
    loginToken: string;
}

// Complex User Account Object.
// D2: no `type =` prefix. D1: ';' terminates fields, ',' separates props.
object UserAccount {
    userId: UUID, assigned = counter, key;
    username: string, key;
    email: string, key;
    profile: UserProfile;
    role: UserRole, default = UserRole.Guest;
    status: AccountStatus, default = AccountStatus.Pending;
    contactMethod: ContactMethod;
    addresses: [Address; 3];
    loginAttempts: uint8, default = 0, range(0, MAX_LOGIN_ATTEMPTS);
    lastLoginTimestamp: Timestamp;
    twoFactorEnabled: bool, default = false;
}

// Object for User Preferences.
// D6 rule 2: userId is `key`, so it needs both a key declaration naming
// it and a keymap using it — see PreferencesKey below.
object UserPreferences {
    userId: UUID, key;
    theme: string, default = DEFAULT_THEME;
    notifications: bool, default = true;
    language: string, default = "en";
}

// Primary key for UserPreferences. D6: there is no implicit primary key;
// the access path an object is created through must be named.
key PreferencesKey {
    userId: UUID;
}

keymap PreferencesKey:UserPreferences {
    userId -> userId
}, primary, name = "PreferencesLookup";

// Key Maps for User Account.
// D6: a keymap relates a key to the object that key is defined for.
// Defect 8: bodies bind with '->'. Defect 9: props are comma-led, ';'-terminated.
keymap UserProfile:UserAccount {
    username -> username,
    email -> email
}, primary, name = "ProfileToAccount";

keymap AuthKey:UserAccount {
    loginToken -> userId
}, name = "AuthToAccount";

// Defect 17: the original file had `keymap UserId:UserAccount`, but no
// `key UserId` was ever declared. Declared here so the reference resolves.
key UserId {
    userId: UUID;
}

keymap UserId:UserAccount {
    userId -> userId
}, primary, name = "UserIdToAccount";

// Organization Key and Object
key OrganizationKey {
    orgId: UUID;
    orgName: string;
}

object Organization {
    orgId: UUID, assigned = counter, key;
    orgName: string, key;
    domain: string;
    foundedDate: Timestamp;
    status: string;
}

// Membership Object.
// A composite key: userId and orgId together identify a membership.
// D6: composite keys come from multiple `key` field props on one object.
object OrganizationMembership {
    userId: UUID, key;
    orgId: UUID, key;
    role: UserRole;
    joinDate: Timestamp;
}

// The composite primary key, named so membership can be created through it.
key MembershipKey {
    userId: UUID;
    orgId: UUID;
}

keymap MembershipKey:OrganizationMembership {
    userId -> userId,
    orgId -> orgId
}, primary, name = "MembershipLookup";

// Key Maps for Organization
keymap OrganizationKey:Organization {
    orgId -> orgId
}, primary, name = "OrgKeyToOrg";

keymap OrganizationKey:OrganizationMembership {
    orgId -> orgId
}, name = "OrgKeyToMembership";

keymap UserProfile:OrganizationMembership {
    userId -> userId
}, name = "UserToMembership";

// ---------------------------------------------------------------------
// Instance data — D7.
// A .sodl file carries schema AND populated values. These are typed:
// each literal is checked against its declaration, including required
// props and defaults.

Organization acme = {
    orgId: "018f3a2b-0000-7000-8000-000000000001",
    orgName: "Acme Corporation",
    domain: "acme.example",
    status: "active"
};

UserAccount rootUser = {
    userId: "018f3a2b-0000-7000-8000-000000000002",
    username: "root",
    email: "root@acme.example",
    role: UserRole.Admin,
    status: AccountStatus.Active,
    twoFactorEnabled: true
};

UserPreferences rootPrefs = {
    userId: "018f3a2b-0000-7000-8000-000000000002",
    theme: "dark",
    language: "en"
};
