/* SODL — Structured Object Definition Language
 * Complete EBNF grammar.
 *
 * Reconciled against sodl-grammar-audit.md. Decisions D1-D9 are recorded
 * in DECISIONS.md; this file is their encoding.
 *
 * Conventions:
 *   ";" terminates a FIELD.  "," separates PROPS within a field.
 */

/* Top-Level Program Structure
 * D7: a .sodl file carries schema AND populated data.
 */
Program             ::= ImportStatement* TopLevelItem*
TopLevelItem        ::= Declaration | InstanceDecl

/* Import Statement — defect 14: "as" binds after the module string,
 * and the wildcard is braced.
 */
ImportStatement     ::= "import" ImportTarget "from" StringLiteral
                        ("as" Identifier)?
ImportTarget        ::= "{" IdentList "}"      (* Selective imports *)
                      | "{" "*" "}"            (* Wildcard import *)

/* Declarations
 * D16: a struct, union, or object declaration may carry layout modifiers.
 * Absent any, the layout is `packed`, little-endian.
 */
Declaration         ::= LayoutModifier* BaseDeclaration
BaseDeclaration     ::= EnumDecl
                      | UnionDecl
                      | ConstDecl
                      | StructDecl
                      | KeyDecl
                      | ObjectDecl
                      | KeyMapDecl
                      | AliasDecl

/* Layout modifiers — D16.
 * `packed` is the default and need not be written. `fixed` aligns each
 * field to its natural boundary; `fixed(N)` caps that at N bytes, so
 * `packed` == `fixed(1)`. Byte order is independent of padding.
 * Legal only on StructDecl, UnionDecl, and ObjectDecl (static check 11).
 */
LayoutModifier      ::= "packed"
                      | "fixed" ( "(" IntegerLiteral ")" )?
                      | "littleEndian"
                      | "bigEndian"

/* Enum Declaration
 * D16: the representation width is declared, defaulting to uint32. An
 * enum is a fixed-size type of exactly that width.
 */
EnumDecl           ::= "enum" Identifier (":" UnsignedType)? "{" EnumValueList "}"
EnumValueList      ::= EnumValue ("," EnumValue)* ","?
EnumValue          ::= Identifier ("=" IntegerLiteral)?

/* Union Declaration — D12: discriminated union.
 * A tag type plus a `name = tag -> Type` binding per member. Replaces the
 * old bare-identifier form, whose members resolved to nothing (the
 * union-has-no-semantics bug). The tag is the wire discriminant; a union is
 * encoded as the tag followed by the selected member, so its size is the
 * tag plus the largest member — fixed, hence legal in a `[Union; N]` list.
 */
UnionDecl          ::= "union" Identifier ":" UnsignedType "{" UnionMemberList "}"
UnionMemberList    ::= UnionMember+
UnionMember        ::= Identifier "=" IntegerLiteral "->" Type ";"
UnsignedType       ::= "uint8" | "uint16" | "uint32" | "uint64"

/* Const Declaration — D10.
 * Binds a name to a compile-time literal. The type is declared, never
 * inferred, and is a basic type; the value is a single Literal of that
 * type. A const does not reference another const and permits no
 * arithmetic. A const reference is equivalent to its literal at the use
 * site (see static check 6).
 */
ConstDecl          ::= "const" Identifier ":" BasicType "=" Literal ";"

/* Alias Declaration — D11.
 * Binds a name to a type, optionally carrying constraints. A transparent
 * synonym, not a distinct type: an alias resolves to its underlying type
 * everywhere, and is wire-identical to it. Constraints written here travel
 * with the name to every use site (unlike a field's own constraints, which
 * are local — see spec §5.1). An alias may name another alias; the chain's
 * constraints accumulate. A cycle is a static error (check 7).
 */
AliasDecl          ::= "alias" Identifier "=" Type ("," Constraint)* ";"

/* Struct Declaration
 * D1: fields terminate with ";".  D2: no "type =" prefix.
 * D4: Type here is never an anonymous inline object.
 */
StructDecl         ::= "struct" Identifier "{" StructFieldList "}"
StructFieldList    ::= StructField+
StructField        ::= Identifier ":" Type ("," StructFieldProp)* ";"
StructFieldProp    ::= Constraint
                     | "align" "=" IntegerLiteral      (* D16 *)
                     | "reserved"                      (* D16 *)
                     | "strict" "=" StrictValue

/* Key Declaration
 * D6: a key names an access path by which an object may be addressed.
 * Every field listed here must be annotated `key` on the target object,
 * and every `key`-annotated field must be reachable from some key or
 * keymap. Both directions are statically checked; neither is expressible
 * in EBNF alone. See DECISIONS.md D6.
 */
KeyDecl            ::= "key" Identifier "{" KeyFieldList "}"
KeyFieldList       ::= KeyField+
KeyField           ::= Identifier ":" Type ("," MetaProp)* ";"

/* Object Declaration
 * D1: ";" terminates each field.  D2: no "type =" prefix.
 */
ObjectDecl         ::= "object" Identifier "{" ObjectFieldList "}"
ObjectFieldList    ::= ObjectField+
ObjectField        ::= Identifier ":" Type ("," ObjectFieldProp)* ";"
ObjectFieldProp    ::= "assigned" "=" AssignMode
                     | "align" "=" IntegerLiteral      (* D16 *)
                     | "reserved"                      (* D16 *)
                     | "required"
                     | "optional"
                     | "key"
                     | "default" "=" Value
                     | "strict" "=" StrictValue
                     | Constraint

/* Props shared by key fields (D3: constraints are props, not type suffixes) */
MetaProp           ::= "required"
                     | "optional"
                     | Constraint

/* D3: range/pattern attach as comma-led props in every construct.
 * The no-comma form `uint8 range(0,120)` is deliberately NOT grammar:
 * it matched zero sites in either example file.
 */
Constraint         ::= "range" "(" NumberRef "," NumberRef ")"
                     | "pattern" "=" StringRef

/* D10: the literal-bearing positions also accept a const reference — an
 * Identifier resolving to a ConstDecl, standing in as if its value were
 * written inline (static check 6). `default` and instance data need no
 * widening: Value already admits Identifier. */
NumberRef          ::= NumberLiteral | ConstRef
StringRef          ::= StringLiteral | ConstRef
StrictValue        ::= Literal | ConstRef
ConstRef           ::= Identifier

AssignMode         ::= "counter" | "random"

/* Key Map Declaration
 * D6: a keymap relates a key to the object that key is defined for.
 * Defect 3: this list is KeyMapFieldList, distinct from KeyFieldList.
 * Defect 8: bodies bind with "->".
 * Defect 9: trailing props are comma-led and the decl is ";"-terminated.
 */
KeyMapDecl         ::= "keymap" Identifier ":" Identifier "{"
                       KeyMapFieldList "}"
                       ("," KeyMapProp)* ";"
KeyMapFieldList    ::= KeyMapField ("," KeyMapField)* ","?
KeyMapField        ::= Identifier "->" KeyMapTarget
KeyMapTarget       ::= FieldPath | ObjectRef

KeyMapProp         ::= "primary"
                     | "name" "=" StringLiteral
                     | "cascadeDelete"

/* Instance Declarations — D7.
 * Binds a name to a populated value of a declared type. This is what
 * makes SODL a config language rather than a schema-only IDL, and what
 * gives ObjectLiteral a reachable parent (defects 4, 26).
 */
InstanceDecl       ::= TypeName Identifier "=" Value ";"
TypeName           ::= Identifier | QualifiedType

/* Type System
 * D4: no anonymous inline object types — a field's type is always named.
 */
Type               ::= BasicType | ComplexType | ExtensionType | UserType

/* Extension types — D14, D17. Normative, but defined in
 * SODL_Extensions.md rather than the core spec: each is a logical type
 * layered over a core representation, for interop with Avro and Parquet.
 * A core-only implementation rejects or passes these through; it must not
 * mis-encode them.
 */
ExtensionType      ::= TemporalType
TemporalType       ::= "timestamp" "<" TimeUnit ">"
                     | "localTimestamp" "<" TimeUnit ">"
                     | "time" "<" TimeUnit ">"
                     | "date"
                     | "duration"
TimeUnit           ::= "s" | "ms" | "us" | "ns"
BasicType          ::= "uint8" | "uint16" | "uint32" | "uint64"
                     | "int8" | "int16" | "int32" | "int64"
                     | "float32" | "float64"
                     | StringType | "bool"
                     | "bytes"                    (* D9 *)
/* D16: `string<N>` is exactly N bytes and is fixed-size; bare `string` is
 * variable-length and falls under the ordering rule (static check 12).
 */
StringType         ::= "string" ( "<" IntegerLiteral ">" )?

ComplexType        ::= ListType | TLVType
ListType           ::= "[" Type ";" IntegerLiteral "]"
TLVType            ::= "tlv" "<" Type ">"         (* D8: any Type, nesting allowed *)
UserType           ::= Identifier | QualifiedType

/* Dotted Identifiers — D5.
 * Four constructs, four productions. Each is legal only in its own
 * position and resolves in its own scope; collapsing them would cost
 * the diagnostics (defect 12).
 */
QualifiedType      ::= Identifier "." Identifier          (* Crypto.SHA256Hash — module scope *)
EnumMember         ::= Identifier "." Identifier          (* UserRole.Guest — enum scope *)
FieldPath          ::= Identifier ("." Identifier)*       (* deviceInfo.deviceFingerprint — nested field *)
ObjectRef          ::= Identifier "." Identifier          (* Employee.employeeId — cross-object *)

/* Values — D7: ObjectLiteral and ListLiteral are reachable from Value,
 * which is what defect 26 required and defect 4 flagged as missing.
 */
Value              ::= NumberLiteral
                     | StringLiteral
                     | BooleanLiteral
                     | EnumMember
                     | UnionLiteral
                     | Identifier
                     | ObjectLiteral
                     | ListLiteral

/* Union value — D12. The member name selects the tag; the parenthesized
 * value has that member's declared type. Distinguished from a bare
 * Identifier by the following "(" (one token of lookahead). */
UnionLiteral       ::= Identifier "(" Value ")"

ObjectLiteral      ::= "{" ObjectLiteralFieldList? "}"
ObjectLiteralFieldList ::= ObjectLiteralField ("," ObjectLiteralField)* ","?
ObjectLiteralField ::= Identifier ":" Value

ListLiteral        ::= "[" (Value ("," Value)* ","?)? "]"

/* Basic Tokens */
IdentList          ::= Identifier ("," Identifier)* ","?
Identifier         ::= [a-zA-Z_][a-zA-Z0-9_]*
NumberLiteral      ::= IntegerLiteral | FloatLiteral
IntegerLiteral     ::= DecimalLiteral | HexLiteral        (* Defect 11 *)
DecimalLiteral     ::= [0-9]+
HexLiteral         ::= "0x" [0-9a-fA-F]+                  (* Defect 11 *)
FloatLiteral       ::= [0-9]+ "." [0-9]+
StringLiteral      ::= '"' [^"]* '"'
BooleanLiteral     ::= "true" | "false"
Literal            ::= NumberLiteral | StringLiteral | BooleanLiteral

/* Comments — defect 10. Trivia: legal anywhere between tokens. */
Comment            ::= "//" [^\n]*

/* ---------------------------------------------------------------------
 * STATIC CHECKS — required by the language, not expressible in EBNF.
 *
 * 1. (D6) Every field referenced by a KeyDecl or KeyMapDecl must carry
 *    the `key` prop on the target object.
 * 2. (D6) Every `key`-annotated field must be referenced by at least one
 *    KeyDecl or KeyMapDecl. No unused key fields.
 * 3. (D6) A keymap's source key must be declared; its target must be an
 *    object the key is defined for. (Closes defect 17 — example.sodl's
 *    UserId and advanced-examples' DepartmentManager/EmployeeDepartment
 *    referenced keys that never existed.)
 * 4. (D7) An InstanceDecl's Value must structurally match its TypeName,
 *    and satisfy every constraint and `required` prop on that type.
 * 5. (Defect 19, D17) Importing a name that collides with a BasicType or
 *    with an ExtensionType is an error, not shadowing.
 * 6. (D10) A ConstDecl's Literal must be valid for its declared BasicType
 *    (`const X: uint8 = 300` is an error). A const reference must resolve
 *    to a declared const, and is checked in the position exactly as if its
 *    literal were written inline.
 * 7. (D11) An alias may not refer to itself, directly or transitively.
 *    Alias chains must terminate at a non-alias type; a cycle is an error.
 * 8. (D11) An alias's constraints and any constraint added at a use site
 *    both apply — a value must satisfy every constraint along the chain
 *    plus the field's own. Intersection, never override.
 * 9. (D12) A union member's tag must fit its union's tag type. Member
 *    names and tag values are each unique within the union.
 * 11. (D16) Layout modifiers are legal only on a struct, union, or object
 *    declaration, and at most one padding modifier and one byte-order
 *    modifier may appear.
 * 12. (D16) ORDERING RULE. Within a declaration, no fixed-size field may
 *    follow a variable-length field. The variable-length constructs are
 *    bare `string`, `bytes`, `tlv<T>`, and any type transitively containing
 *    one. A type containing a variable-length field is itself
 *    variable-tailed and may appear only as the last field of whatever
 *    contains it.
 * 13. (D16) A fixed-length list `[T; N]` requires T to be fixed-size:
 *    element offsets must be computable.
 * 14. (D16) `string<N>` requires N > 0. A string literal longer than N
 *    bytes is an error where it is statically known.
 * 15. (D16) `align = N` requires N to be a power of two, as does the N in
 *    `fixed(N)`. `reserved` is legal only on a field whose type is
 *    fixed-size.
 * 16. (D17) A TimeUnit is written, never defaulted. `time<us>` and
 *    `time<ns>` are int64; `time<s>` and `time<ms>` are int32.
 * 10. (D12) A union member type must be fixed-size. `bytes` and `tlv<T>`,
 *    the variable-length constructs, are not admissible member types.
 *    (The regex checker sees these directly; it does not trace a struct
 *    member back to a variable-length field it transitively contains.)
 * ------------------------------------------------------------------ */
