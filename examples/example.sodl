// SODL Comprehensive Example
//
// Demonstrates the core constructs: aliases, constants, enums, unions,
// structs, keys, objects, keymaps, and instance data.

// A named type (D11). `alias` binds a name to a type and, here, a
// constraint the name carries everywhere it is used — the only way to name
// a constrained primitive. `UUID` was previously imported from a
// `common_types` module that did not exist; it is a constrained `string`.
// Timestamp is NOT aliased or imported — it is a BasicType (see
// DECISIONS.md, and static check 5: a name colliding with a BasicType is an
// error, not shadowing).
// D16: `string<36>` is exactly 36 bytes — a UUID's canonical text length —
// so UUID is fixed-size and may sit anywhere, including in a fixed list.
// Bare `string` would be variable-length and confined to a trailing region.
alias UUID = string<36>, pattern = "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$";

// Named literals — D10. A const stands in for its value wherever a literal
// of its type is legal: a range bound, a default, and instance data below.
const MAX_LOGIN_ATTEMPTS: uint8 = 5;
const DEFAULT_THEME: string = "light";

// Enum for user roles. D16: an enum declares its width, defaulting to
// uint32; these fit a byte.
enum UserRole : uint8 {
    Admin = 1,
    Editor = 2,
    Viewer = 3,
    Guest = 4
}

// Enum for account status
enum AccountStatus : uint8 {
    Active = 1,
    Suspended = 2,
    Locked = 3,
    Pending = 4
}

// Discriminated union for contact methods (D12).
// A tag type (uint8, the wire discriminant) plus a `name = tag -> Type`
// binding per member. Each member type is fixed-size, so ContactMethod is
// fixed-size and may sit in a fixed-length list.
// D16: every member is fixed-size, so ContactMethod is too and may appear
// in `[ContactMethod; N]`. A bare `string` member would make it
// variable-tailed and inadmissible there.
union ContactMethod : uint8 {
    Email  = 1 -> string<254>;
    Phone  = 2 -> string<32>;
    Postal = 3 -> Address;
}

// Struct for detailed address.
// D1: every field terminates with ';', in structs as in objects.
// D16: bounded strings keep Address fixed-size, which is what lets
// `[Address; 3]` compute element offsets. With bare `string` fields it
// would be variable-tailed and illegal as a fixed list's element type.
struct Address {
    street: string<64>;
    city: string<48>;
    state: string<32>;
    zipCode: string<16>;
    country: string<56>;
    latitude: float64;
    longitude: float64;
    elevationMeters: float32;
}

// Key for User Profile.
// D6: every field named here carries the `key` prop on UserAccount, and
// every `key`-annotated field on UserAccount is reachable from some key
// or keymap. Both directions are checked.
key UserProfile {
    userId: UUID;
    username: string<32>;
    email: string<254>;
}

// Key for Authentication
key AuthKey {
    loginToken: string<64>;
}

// Complex User Account Object.
// D2: no `type =` prefix. D1: ';' terminates fields, ',' separates props.
object UserAccount {
    userId: UUID, assigned = counter, key;
    username: string<32>, key;
    email: string<254>, key;
    profile: UserProfile;
    role: UserRole, default = UserRole.Guest;
    status: AccountStatus, default = AccountStatus.Pending;
    contactMethod: ContactMethod;
    addresses: [Address; 3];
    loginAttempts: uint8, default = 0, range(0, MAX_LOGIN_ATTEMPTS);
    lastLoginTimestamp: Timestamp;
    twoFactorEnabled: bool, default = false;
}

// Object for User Preferences.
// D6 rule 2: userId is `key`, so it needs both a key declaration naming
// it and a keymap using it — see PreferencesKey below.
object UserPreferences {
    userId: UUID, key;
    theme: string<16>, default = DEFAULT_THEME;
    notifications: bool, default = true;
    language: string<8>, default = "en";
}

// Primary key for UserPreferences. D6: there is no implicit primary key;
// the access path an object is created through must be named.
key PreferencesKey {
    userId: UUID;
}

keymap PreferencesKey:UserPreferences {
    userId -> userId
}, primary, name = "PreferencesLookup";

// Key Maps for User Account.
// D6: a keymap relates a key to the object that key is defined for.
// Defect 8: bodies bind with '->'. Defect 9: props are comma-led, ';'-terminated.
keymap UserProfile:UserAccount {
    username -> username,
    email -> email
}, primary, name = "ProfileToAccount";

keymap AuthKey:UserAccount {
    loginToken -> userId
}, name = "AuthToAccount";

// Defect 17: the original file had `keymap UserId:UserAccount`, but no
// `key UserId` was ever declared. Declared here so the reference resolves.
key UserId {
    userId: UUID;
}

keymap UserId:UserAccount {
    userId -> userId
}, primary, name = "UserIdToAccount";

// Organization Key and Object
key OrganizationKey {
    orgId: UUID;
    orgName: string<128>;
}

object Organization {
    orgId: UUID, assigned = counter, key;
    orgName: string<128>, key;
    domain: string<253>;
    foundedDate: Timestamp;
    status: string<16>;
    employeeCount: int64;
}

// Membership Object.
// A composite key: userId and orgId together identify a membership.
// D6: composite keys come from multiple `key` field props on one object.
object OrganizationMembership {
    userId: UUID, key;
    orgId: UUID, key;
    role: UserRole;
    joinDate: Timestamp;
}

// The composite primary key, named so membership can be created through it.
key MembershipKey {
    userId: UUID;
    orgId: UUID;
}

keymap MembershipKey:OrganizationMembership {
    userId -> userId,
    orgId -> orgId
}, primary, name = "MembershipLookup";

// Key Maps for Organization
keymap OrganizationKey:Organization {
    orgId -> orgId
}, primary, name = "OrgKeyToOrg";

keymap OrganizationKey:OrganizationMembership {
    orgId -> orgId
}, name = "OrgKeyToMembership";

keymap UserProfile:OrganizationMembership {
    userId -> userId
}, name = "UserToMembership";

// ---------------------------------------------------------------------
// Instance data — D7.
// A .sodl file carries schema AND populated values. These are typed:
// each literal is checked against its declaration, including required
// props and defaults.

Organization acme = {
    orgId: "018f3a2b-0000-7000-8000-000000000001",
    orgName: "Acme Corporation",
    domain: "acme.example",
    status: "active",
    employeeCount: 350
};

UserAccount rootUser = {
    userId: "018f3a2b-0000-7000-8000-000000000002",
    username: "root",
    email: "root@acme.example",
    role: UserRole.Admin,
    status: AccountStatus.Active,
    contactMethod: Email("root@acme.example"),
    twoFactorEnabled: true
};

UserPreferences rootPrefs = {
    userId: "018f3a2b-0000-7000-8000-000000000002",
    theme: "dark",
    language: "en"
};
