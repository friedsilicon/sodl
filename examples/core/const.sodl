// const — D10. A named compile-time literal.

const MAX_LOGIN_ATTEMPTS: uint8  = 5;
const DEFAULT_THEME:      string = "light";
const RETRY_ENABLED:      bool   = true;
const TAG_MASK:           uint16 = 0xFF;
const SCALE_FACTOR:       float32 = 1.5;

// A const stands in wherever its literal would be legal: a range bound, a
// default, a strict value, or instance data. See core/alias.sodl for a
// range bound naming one, and core/struct.sodl for fields that use them.
