// Advanced SODL Examples
//
// Demonstrates the features the basic example omits: aliases, hex enum
// values, constraints, qualified types, nested field paths, cross-object
// refs, TLV over compound types, `bytes`, and structured instance data.

// Import common types and utilities.
// Timestamp is NOT imported — it is a BasicType (static check 5).
import { GeoLocation } from "common_types"
import { EmailAddress, PhoneNumber, IPAddress } from "validated_types"
import { * } from "crypto_types" as Crypto

// Named literals — D10. Used below as range bounds, a default, and in
// instance data. A const stands in exactly as if its value were inline.
const MIN_PASSWORD_LENGTH: uint8 = 8;
const MAX_PASSWORD_LENGTH: uint8 = 128;
const DEFAULT_SESSION_TIMEOUT: uint32 = 3600;

// Named types (D11). An alias binds a name to a type; a constraint written
// here travels with the name to every use site (unlike a field's own
// constraint, which is local). `UUID` and `Money` were previously imported
// from a `common_types` module that did not exist — they are constrained
// primitives, which no other construct can name.
alias UUID  = string<36>, pattern = "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$";
alias Money = string<24>, pattern = "^[0-9]+\.[0-9]{2}$";

// An alias may name another alias — chains resolve transitively and their
// constraints accumulate. `EntityId` is transparently a `UUID`, hence a
// constrained `string`.
alias EntityId = UUID;

// A constraint on an alias is a floor, not a ceiling: a use site may pin a
// tighter bound on top (intersection, never override). `AddressIndex`
// admits 0..9 in general; the `preferredAddress` field below narrows it to
// the five shipping addresses actually present. Both bounds apply.
alias AddressIndex = uint8, range(0, 9);

// Advanced enum with explicit hex values (defect 11).
// Bit flags, so each value is a distinct bit.
enum TransactionStatus : uint8 {
    Pending = 0x01,    // Transaction initiated
    Verified = 0x02,   // Transaction verified but not processed
    Processing = 0x04, // Transaction is being processed
    Completed = 0x08,  // Transaction successfully completed
    Failed = 0x10,     // Transaction failed
    Reversed = 0x20    // Transaction was reversed
}

// Discriminated union with multiple options (D12). Every member type is
// fixed-size, so AuthenticationFactor is fixed-size and `[AuthenticationFactor;
// 3]` below has a defined length. D16: `bytes` and bare `string` are both
// rejected here — either would make the union variable-tailed — so the
// token members are bounded and BiometricData is a fixed [uint8; N] run.
union AuthenticationFactor : uint8 {
    PasswordHash = 1 -> Crypto.SHA256Hash;
    TOTPToken    = 2 -> string<8>;
    BiometricData = 3 -> [uint8; 512];
    SecurityKey  = 4 -> [uint8; 64];
    RecoveryCode = 5 -> string<16>;
}

// D4: named structs only — no anonymous inline object types.
// The original nested this brace-block directly inside
// SecurityConfiguration; it is lifted to a named struct.
struct PasswordPolicy {
    minLength: uint8, range(MIN_PASSWORD_LENGTH, MAX_PASSWORD_LENGTH);
    requireSpecialChars: bool;
    requireNumbers: bool;
    requireUppercase: bool;
    passwordHistory: uint8, range(0, 24);
}

// Struct with nested types and constraints.
// D3: range/pattern are comma-led props, never type suffixes.
struct SecurityConfiguration {
    maxLoginAttempts: uint8, range(3, 10);
    passwordPolicy: PasswordPolicy;
    sessionTimeout: uint32, range(300, 86400), default = DEFAULT_SESSION_TIMEOUT;  // 5 min to 24 h
}

// D4: lifted from the anonymous `deviceInfo: { ... }` in UserSession.
// D16: bounded strings keep DeviceInfo fixed-size. Were userAgent a bare
// `string`, DeviceInfo would be variable-tailed and could only appear as the
// last field of UserSession — where it is followed by five more.
struct DeviceInfo {
    userAgent: string<128>, required;
    ipAddress: IPAddress, required;
    geoLocation: GeoLocation, optional;
    deviceFingerprint: string<64>, pattern = "^[a-f0-9]{64}$";
}

// Key with complex validation.
// D5: Crypto.SHA256Hash is a QualifiedType — resolved in module scope.
key SessionKey {
    sessionId: Crypto.SHA256Hash;
    deviceFingerprint: string<64>, pattern = "^[a-f0-9]{64}$";
    ipAddress: IPAddress;
}

// Object with advanced type constraints and relationships.
// D6: every `key` field here is named by a key declaration AND used by a
// keymap. deviceInfo is deliberately NOT `key` — SessionLookup reaches
// into it by FieldPath, which addresses the nested field, not the struct.
object UserSession {
    sessionId: Crypto.SHA256Hash, assigned = random, key;
    userId: UUID, key;
    deviceInfo: DeviceInfo;
    authFactors: [AuthenticationFactor; 3];
    securityLevel: uint8, range(1, 5);
    lastActivity: Timestamp;
    expiresAt: Timestamp;
    metadata: tlv<string>;  // Variable length metadata
}

// Secondary access path: retrieve a session by the user it belongs to.
key UserSessionsKey {
    userId: UUID;
}

keymap UserSessionsKey:UserSession {
    userId -> userId
}, name = "SessionsByUser";

// D4: lifted from the anonymous `customer: { ... }` in ECommerceOrder.
struct OrderCustomer {
    userId: UUID, required;
    email: EmailAddress, required;
    phone: PhoneNumber, optional;
    shippingAddresses: [Address; 5];
    // D11: the field narrows AddressIndex's 0..9 to 0..4. Intersection —
    // the value must satisfy both the alias's bound and the field's.
    preferredAddress: AddressIndex, range(0, 4);
}

// D4: lifted from the anonymous element type of `items: [{ ... }; 50]`.
// D16: `metadata: tlv<string>` was removed. A tlv is variable-length, which
// would make OrderItem variable-tailed — and `[OrderItem; 50]` below needs a
// fixed-size element to compute offsets. tlv is still demonstrated on
// UserSession and CacheEntry, whose trailing regions can carry it.
struct OrderItem {
    productId: UUID;
    quantity: uint16, range(1, 1000);
    price: Money;
    discounts: [string<16>; 5];
}

// D4: lifted from the anonymous `payment: { ... }` in ECommerceOrder.
struct OrderPayment {
    method: string<24>;
    status: TransactionStatus;
    amount: Money;
    currency: string<3>, pattern = "^[A-Z]{3}$";
    processorRef: string<64>;
}

// Complex object with nested arrays and validation
object ECommerceOrder {
    orderId: UUID, assigned = counter, key;
    customer: OrderCustomer;
    items: [OrderItem; 50];
    payment: OrderPayment;
    status: string<16>;
    createdAt: Timestamp;
    updatedAt: Timestamp;
}

key OrderKey {
    orderId: UUID;
}

keymap OrderKey:ECommerceOrder {
    orderId -> orderId
}, primary, name = "OrderLookup";

// Advanced keymap with multiple relationships and cascade delete.
// D5: deviceInfo.deviceFingerprint is a FieldPath — a nested field
// within this object, distinct from a cross-object ObjectRef.
keymap SessionKey:UserSession {
    sessionId -> sessionId,
    deviceFingerprint -> deviceInfo.deviceFingerprint,
    ipAddress -> deviceInfo.ipAddress
}, primary, name = "SessionLookup", cascadeDelete;

// Demonstration of circular references and complex relationships
object Department {
    deptId: UUID, assigned = counter, key;
    name: string<64>, required;
    managerId: UUID, optional, key;   // References an Employee
    location: GeoLocation;
    budget: Money;
    employees: [UUID; 100];           // Array of Employee IDs
}

object Employee {
    employeeId: UUID, assigned = counter, key;
    departmentId: UUID, key;  // References a Department
    supervisor: UUID, optional;         // References another Employee
    subordinates: [UUID; 20];           // Array of Employee IDs
    permissions: [string<32>; 50];
    accessLevel: uint8, range(1, 10);
    hireDate: Timestamp;
    status: string<16>, pattern = "^(Active|OnLeave|Terminated)$";
}

// Complex keymaps for circular references.
// Defect 17: the original referenced `DepartmentManager` and
// `EmployeeDepartment` as keys, but neither was ever declared. Declared
// here so the references resolve.
// D5: Employee.employeeId is an ObjectRef — cross-object, resolved in
// object scope, distinct from a same-object FieldPath.
// Primary key for Department.
key DepartmentKey {
    deptId: UUID;
}

keymap DepartmentKey:Department {
    deptId -> deptId
}, primary, name = "DepartmentLookup";

// Secondary access path: find a department by its manager.
key DepartmentManager {
    managerId: UUID;
}

keymap DepartmentManager:Department {
    managerId -> Employee.employeeId
}, name = "DepartmentManagement";

key EmployeeDepartment {
    departmentId: UUID;
    employeeId: UUID;
}

keymap EmployeeDepartment:Employee {
    departmentId -> Department.deptId,
    employeeId -> Employee.employeeId
}, primary, name = "EmployeeDepartmentRelation";

// Demonstration of type inheritance and composition
struct BaseAuditInfo {
    createdAt: Timestamp;
    createdBy: UUID;
    updatedAt: Timestamp;
    updatedBy: UUID;
    version: uint32;
}

// D4: lifted from the anonymous element type of `changes: [{ ... }; 100]`.
struct AuditChange {
    field: string<64>;
    oldValue: string<128>;
    newValue: string<128>;
    timestamp: Timestamp;
    changedBy: UUID;
}

object AuditedEntity {
    // D11: EntityId chains onto UUID — a transparent synonym, so this is
    // the same type the AuditedEntityKey declaration names as UUID.
    entityId: EntityId, assigned = counter, key;
    entityType: string<32>;
    auditInfo: BaseAuditInfo;
    changes: [AuditChange; 100];
}

key AuditedEntityKey {
    entityId: UUID;
}

keymap AuditedEntityKey:AuditedEntity {
    entityId -> entityId
}, primary, name = "AuditedEntityLookup";

// ---------------------------------------------------------------------
// D9 — the `bytes` primitive.
// Variable-length binary: certs, keys, hashes, cache bodies. Distinct
// from [uint8; N], which is fixed-length.

// D16 ordering rule: fingerprint is fixed-size, so it precedes the two
// variable-length fields. Written the other way round — as it originally
// was — the fixed field would follow a variable one and have no computable
// offset. Both `bytes` fields share the trailing region and decode in order.
struct TlsIdentity {
    fingerprint: [uint8; 32];          // fixed length — SHA-256
    certificate: bytes, required;      // variable length — DER cert
    privateKey: bytes, required;       // variable length
}

// D16: the fixed fields come first, then the variable trailing region.
object CacheEntry {
    cacheKey: Crypto.SHA256Hash, key;
    contentType: string<64>;
    storedAt: Timestamp;
    body: bytes;                       // arbitrary payload — variable
    // D8: tlv accepts any Type, not just primitives. T = tag,
    // L = byte length, V = inner encoding; nesting is allowed.
    headers: tlv<AuditChange>;
    trailers: tlv<tlv<string>>;        // nested TLV
}

key CacheEntryKey {
    cacheKey: Crypto.SHA256Hash;
}

keymap CacheEntryKey:CacheEntry {
    cacheKey -> cacheKey
}, primary, name = "CacheLookup";

// ---------------------------------------------------------------------
// Instance data — D7.
// Structured literals: nested objects and lists, checked against their
// declarations.

PasswordPolicy strictPolicy = {
    minLength: 16,
    requireSpecialChars: true,
    requireNumbers: true,
    requireUppercase: true,
    passwordHistory: 12
};

SecurityConfiguration productionSecurity = {
    maxLoginAttempts: 5,
    passwordPolicy: {
        minLength: 16,
        requireSpecialChars: true,
        requireNumbers: true,
        requireUppercase: true,
        passwordHistory: 12
    },
    sessionTimeout: DEFAULT_SESSION_TIMEOUT
};

OrderItem sampleItem = {
    productId: "018f3a2b-0000-7000-8000-00000000000a",
    quantity: 2,
    price: "49.99",
    discounts: ["LAUNCH10", "BUNDLE5"]
};
